<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Deslumbra</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Deslumbra.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- MENÚ PRINCIPAL -->
    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">

            <div class="container">

                <!-- Nombre de la tienda -->
                <a class="navbar-brand fw-bold fs-4"
                   asp-controller="Home"
                   asp-action="Index">
                    DESLUMBRA
                </a>

                <!-- Menú para celulares -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuDeslumbra"
                        aria-controls="menuDeslumbra"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="menuDeslumbra">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <!-- Inicio -->
                        <li class="nav-item">

                            <a class="nav-link text-dark mx-2"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>

                        </li>

                        <!-- Catálogo -->
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle text-dark mx-2"
                               href="#"
                               id="menuCatalogo"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Catálogo
                            </a>

                            <ul class="dropdown-menu"
                                aria-labelledby="menuCatalogo">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Productos"
                                       asp-action="Index">
                                        Todas las prendas
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Productos"
                                       asp-action="Index"
                                       asp-route-categoria="Mujeres">
                                        Mujeres
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Productos"
                                       asp-action="Index"
                                       asp-route-categoria="Hombres">
                                        Hombres
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Productos"
                                       asp-action="Index"
                                       asp-route-categoria="Niños">
                                        Niños
                                    </a>
                                </li>

                            </ul>

                        </li>

                        <!-- Quiénes somos -->
                        <li class="nav-item">

                            <a class="nav-link text-dark mx-2"
                               asp-controller="Home"
                               asp-action="QuienesSomos">
                                Quiénes somos
                            </a>

                        </li>

                        <!-- Panel exclusivo del administrador -->
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark mx-2"
                                   asp-controller="Panel"
                                   asp-action="Index">
                                    Panel de administración
                                </a>

                            </li>
                        }

                        <!-- Carrito de compras -->
                        <li class="nav-item ms-lg-3">

                            <a class="nav-link text-dark"
                               asp-controller="Carrito"
                               asp-action="Index"
                               title="Mi carrito de compras"
                               aria-label="Mi carrito de compras">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="23"
                                     height="23"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.7"
                                     stroke-linecap="round"
                                     stroke-linejoin="round"
                                     viewBox="0 0 24 24">

                                    <circle cx="9" cy="21" r="1" />

                                    <circle cx="20" cy="21" r="1" />

                                    <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6" />

                                </svg>

                            </a>

                        </li>

                        <!-- Acceso del administrador -->
                        <li class="nav-item ms-lg-3">

                            @if (User.IsInRole("Administrador"))
                            {
                                <form asp-controller="Admin"
                                      asp-action="Salir"
                                      method="post">

                                    <button type="submit"
                                            class="btn btn-outline-dark btn-sm">
                                        Cerrar sesión
                                    </button>

                                </form>
                            }
                            else
                            {
                                <a class="nav-link text-dark"
                                   asp-controller="Admin"
                                   asp-action="Ingresar"
                                   title="Acceso de administrador"
                                   aria-label="Acceso de administrador">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="22"
                                         height="22"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.7"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         viewBox="0 0 24 24">

                                        <circle cx="12" cy="8" r="4" />

                                        <path d="M4 21a8 8 0 0 1 16 0" />

                                    </svg>

                                </a>
                            }

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- CONTENIDO -->
    <div class="container-fluid px-0">

        <main role="main">
            @RenderBody()
        </main>

    </div>

    <!-- PIE DE PÁGINA -->
    <footer class="border-top text-muted py-4 mt-5">

        <div class="container text-center">

            <p class="mb-1">
                &copy; 2026 - DESLUMBRA
            </p>

            <small>
                Tu estilo, tu esencia
            </small>

        </div>

    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
