@{
    ViewData["Title"] = "Quiénes somos";
}

<!-- Presentación -->
<section class="text-center py-5"
         style="background-color:#f5eee7;">

    <div class="container py-5">

        <h1 class="display-5 fw-bold mb-3">
            ¿Quiénes somos?
        </h1>

        <p class="fs-5 text-muted">
            Más que moda, una forma de expresar quién eres.
        </p>

    </div>

</section>

<!-- Nuestra historia -->
<section class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8 text-center">

            <h2 class="mb-4">
                ¡¡Bienvenidos a Deslumbra!!
            </h2>

            <p class="fs-5 text-muted">
                Deslumbra nace con la idea de ofrecer
                moda para mujeres, hombres y niños,
                combinando estilo, comodidad y versatilidad.
            </p>

            <p class="fs-5 text-muted">
                Creemos que cada persona tiene una
                personalidad única y que la ropa puede
                ser una forma de expresar su esencia.
            </p>

            <p class="fs-5 text-muted">
                Nuestro propósito es brindar una experiencia
                de compra sencilla y agradable, donde
                encontrar prendas para diferentes gustos
                y ocasiones.
            </p>

        </div>

    </div>

</section>

<!-- Misión y visión -->
<section class="container pb-5">

    <div class="row g-4">

        <div class="col-md-6">

            <div class="card h-100 shadow-sm">

                <div class="card-body p-4 text-center">

                    <h3 class="mb-3">Nuestra misión</h3>

                    <p class="text-muted">
                        Ofrecer prendas modernas, cómodas
                        y accesibles que permitan a cada
                        persona expresar su estilo con
                        confianza.
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card h-100 shadow-sm">

                <div class="card-body p-4 text-center">

                    <h3 class="mb-3">Nuestra visión</h3>

                    <p class="text-muted">
                        Ser una tienda reconocida por
                        ofrecer una experiencia de compra
                        agradable, variedad de estilos
                        y atención a las necesidades
                        de nuestros clientes.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Invitación -->
<section class="text-center py-5"
         style="background-color:#f5eee7;">

    <div class="container">

        <h2 class="mb-3">
            Encuentra tu estilo
        </h2>

        <p class="text-muted mb-4">
            Descubre nuestras colecciones y elige
            las prendas que mejor representan tu esencia.
        </p>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-dark px-5">
            Explorar catálogo
        </a>

    </div>

</section>