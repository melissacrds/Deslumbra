@model List<Deslumbra.Models.CarritoItem>

@{
    ViewData["Title"] = "Mi carrito";

    decimal total = Model.Sum(p => p.Subtotal);
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold">
            Mi carrito de compras
        </h1>

        <p class="text-muted">
            Revisa tus prendas antes de realizar tu pedido.
        </p>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">

            <h4>Tu carrito está vacío</h4>

            <p class="text-muted">
                Explora nuestro catálogo y encuentra
                tus prendas favoritas.
            </p>

            <a asp-controller="Productos"
               asp-action="Index"
               class="btn btn-dark mt-3">
                Explorar catálogo
            </a>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Talla</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var producto in Model)
                    {
                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    @if (!string.IsNullOrEmpty(producto.Imagen))
                                    {
                                        <img src="@producto.Imagen"
                                             alt="@producto.Nombre"
                                             class="rounded"
                                             style="width:65px;height:80px;object-fit:cover;" />
                                    }

                                    <span class="fw-semibold">
                                        @producto.Nombre
                                    </span>

                                </div>
                            </td>

                            <td>
                                @producto.Talla
                            </td>

                            <td>
                                ₡@producto.Precio.ToString("N2")
                            </td>

                            <td>
                                <form asp-controller="Carrito"
                                      asp-action="Actualizar"
                                      method="post"
                                      class="d-flex align-items-center gap-2">

                                    <input type="hidden"
                                           name="idProducto"
                                           value="@producto.IdProducto" />

                                    <input type="hidden"
                                           name="talla"
                                           value="@producto.Talla" />

                                    <input type="number"
                                           name="cantidad"
                                           value="@producto.Cantidad"
                                           min="1"
                                           max="999999"
                                           required
                                           class="form-control form-control-sm"
                                           style="width:85px;" />

                                    <button type="submit"
                                            class="btn btn-outline-dark btn-sm">
                                        Actualizar
                                    </button>

                                </form>
                            </td>

                            <td class="fw-semibold">
                                ₡@producto.Subtotal.ToString("N2")
                            </td>

                            <td>
                                <form asp-controller="Carrito"
                                      asp-action="Eliminar"
                                      method="post">

                                    <input type="hidden"
                                           name="idProducto"
                                           value="@producto.IdProducto" />

                                    <input type="hidden"
                                           name="talla"
                                           value="@producto.Talla" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Eliminar
                                    </button>

                                </form>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- Resumen de compra -->
        <div class="row justify-content-end mt-5">

            <div class="col-md-5">

                <div class="card shadow-sm">

                    <div class="card-body p-4">

                        <h4 class="mb-4">
                            Resumen de compra
                        </h4>

                        <div class="d-flex justify-content-between mb-3">

                            <span>Unidades:</span>

                            <strong>
                                @Model.Sum(p => p.Cantidad)
                            </strong>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">

                            <h5>Total:</h5>

                            <h5 class="fw-bold">
                                ₡@total.ToString("N2")
                            </h5>

                        </div>

                        <!-- Finalizar por WhatsApp -->
                        <form asp-controller="Carrito"
                              asp-action="FinalizarPedido"
                              method="post">

                            <button type="submit"
                                    class="btn btn-success w-100 mb-3">

                                Finalizar pedido por WhatsApp

                            </button>

                        </form>

                        <p class="text-muted small text-center">
                            Se abrirá WhatsApp con tu pedido
                            preparado. Deberás presionar Enviar
                            para compartirlo con la tienda.
                            La disponibilidad y la entrega
                            se confirmarán por ese medio.
                        </p>

                        <hr />

                        <a asp-controller="Productos"
                           asp-action="Index"
                           class="btn btn-dark w-100 mb-2">
                            Seguir comprando
                        </a>

                        <form asp-controller="Carrito"
                              asp-action="Vaciar"
                              method="post"
                              onsubmit="return confirm('¿Deseas vaciar el carrito?');">

                            <button type="submit"
                                    class="btn btn-outline-danger w-100">
                                Vaciar carrito
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }

</div>